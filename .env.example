# Required: local PostgreSQL, or a Supabase direct/session-pooler PostgreSQL URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Optional. With no Supabase credentials, secure local authentication and private disk storage work.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=filebox
# Absolute persistent disk path recommended in production. Never put this under public/.
FILE_STORAGE_DIR=.filebox-storage
# Bytes. Defaults to 5 GiB per account.
DEFAULT_STORAGE_QUOTA=5368709120
# Canonical public URL for deployment.
APP_URL=http://localhost:3000
